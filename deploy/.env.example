# ICA 招新平台后端环境变量模板（复制为 backend/.env 并填写）
SITE_URL=https://ica.hub.tt2.li
DEBUG=false

DATABASE_URL=postgresql+asyncpg://ica:<密码>@127.0.0.1:5432/ica
REDIS_URL=redis://127.0.0.1:6379/11

JWT_SECRET=<openssl rand -hex 32>
FERNET_KEY=<python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# 观猹 OAuth2 客户端（正式凭证需向观猹申请，文档内为测试凭证）
WATCHA_CLIENT_ID=
WATCHA_CLIENT_SECRET=
WATCHA_SCOPE=read

# 平台管理员的观猹 user_id 白名单（逗号分隔）；社团内角色由各社团管理员在后台管理
ADMIN_WATCHA_IDS=

# TokenDance 站点兜底 Key（供未连接 Token 钱包的用户按日配额使用）
TOKENDANCE_API_KEY=
TOKENDANCE_APP_URL=https://ica.hub.tt2.li

# AI 配额（每日，staff/admin ×10）
AI_QUOTA_CHAT_DAILY=20
AI_QUOTA_IMAGE_DAILY=2
